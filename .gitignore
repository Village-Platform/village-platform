/.bundle
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep
/storage/*
!/storage/.keep
/config/master.key
/config/credentials/*.key
.env
.env.*
!.env.example
/coverage

# Ignore key files for decrypting credentials and more.
/config/*.key


# Tailwind build output; compiled by assets:precompile.
/app/assets/builds/*
!/app/assets/builds/.keep

# Precompiled assets. The Vercel image runs assets:precompile during its build;
# committing host output here shadows the load path and hides newly added assets.
/public/assets

