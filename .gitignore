/.bundle
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep
/storage/*
!/storage/.keep
/config/master.key
/config/credentials/*.key
.env
.env.*
!.env.example
/coverage

# Ignore key files for decrypting credentials and more.
/config/*.key


# Tailwind build output; compiled by assets:precompile.
/app/assets/builds/*
!/app/assets/builds/.keep
