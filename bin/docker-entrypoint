#!/bin/bash -e
# Runs before the server starts (every cold start on Vercel).
# - Migrates the database, and on an empty database loads the schema and runs the seeds.
#   db:prepare_locked holds an advisory lock, so containers that start together take turns.
#   Uses the direct (unpooled) connection when the provider offers one, because advisory
#   locks are session-level and a transaction pooler does not keep them.
# - Set DB_PREPARE_ON_BOOT=0 to skip it (e.g. when you migrate from your machine instead).

if [ "${DB_PREPARE_ON_BOOT:-1}" = "1" ] && [ "${*: -1:1}" != "console" ]; then
  DATABASE_URL="${DATABASE_URL_UNPOOLED:-$DATABASE_URL}" ./bin/rails db:prepare_locked
fi

exec "${@}"
