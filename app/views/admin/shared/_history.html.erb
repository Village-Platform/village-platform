<%# History of one record: render "admin/shared/history", record: @firm %>
<% events = AuditEvent.for_subject(record).includes(:actor).latest_first.limit(20) %>
<section class="card mt">
  <div class="card-header"><h2>سجل التعديلات</h2></div>
  <% if events.any? %>
    <div class="tbl">
      <table>
        <thead><tr><th>الوقت</th><th>المنفّذ</th><th>العملية</th><th>العنصر</th><th>التغييرات</th><th>المصدر</th></tr></thead>
        <tbody><%= render partial: "admin/audit_events/row", collection: events, as: :event %></tbody>
      </table>
    </div>
  <% else %>
    <%= empty_state("لا توجد تعديلات مسجلة.") %>
  <% end %>
</section>
