<% if meta[:total_pages] > 1 %>
  <nav class="pagination">
    <% if meta[:page] > 1 %>
      <%= link_to "السابق", url_for(filter_params(page: meta[:page] - 1)), class: "btn btn-ghost btn-sm" %>
    <% end %>
    <span>صفحة <%= meta[:page] %> من <%= meta[:total_pages] %> (<%= meta[:total] %>)</span>
    <% if meta[:page] < meta[:total_pages] %>
      <%= link_to "التالي", url_for(filter_params(page: meta[:page] + 1)), class: "btn btn-ghost btn-sm" %>
    <% end %>
  </nav>
<% end %>
