<%= page_header "الاشتراكات", subtitle: "طلبات أصحاب الأنشطة عبر إنستاباي وفودافون كاش" %>

<div class="flex flex-wrap gap-2 items-center">
  <%= filter_tabs :status, enum_options(Subscription, :status) %>
  <div class="flex-1"></div>
  <%= form_with url: admin_subscriptions_path, method: :get, class: "flex flex-wrap gap-2 items-center" do |f| %>
    <%= f.hidden_field :status, value: params[:status] %>
    <%= search_combobox("subscriptions") do |attrs| %>
      <%= f.search_field :q, value: params[:q], placeholder: "رقم العملية أو الهاتف", class: "w-52", "aria-label": "بحث", **attrs %>
    <% end %>
    <%= f.select :payment_method,
          options_for_select(enum_options(Subscription, :payment_method), params[:payment_method]),
          { include_blank: "كل طرق الدفع" }, { class: "w-40", "aria-label": "طريقة الدفع" } %>
    <%= button_tag type: "submit", class: "btn btn-ghost", name: nil, title: "تصفية" do %><%= icon(:search, size: 16) %><% end %>
  <% end %>
</div>

<div class="tbl">
  <% if @subscriptions.any? %>
    <table>
      <thead>
        <tr><th>#</th><th>صاحب الطلب</th><th>الباقة</th><th>المبلغ</th><th>الدفع</th><th>رقم العملية</th><th>الحالة</th><th>الوضع</th><th>التاريخ</th><th></th></tr>
      </thead>
      <tbody>
        <% @subscriptions.each do |s| %>
          <tr>
            <td><%= s.id %></td>
            <td><%= link_to s.user.name, admin_subscription_path(s), class: "cell-main" %><span class="cell-sub ltr"><%= s.user.phone %></span></td>
            <td><%= s.subscription_plan.name %></td>
            <td><%= egp(s.amount_cents) %></td>
            <td><%= enum_label(Subscription, :payment_method, s.payment_method) %></td>
            <td class="ltr"><%= s.transaction_reference %></td>
            <td><%= enum_badge(Subscription, :status, s.status) %></td>
            <td><%= enum_badge(Subscription, :state, s.state) %></td>
            <td>
              <%= fmt_date(s.created_at) %>
              <% if s.pending? %>
                <% hours = ((Time.current - s.created_at) / 1.hour).floor %>
                <span class="cell-sub"><%= badge("منذ #{hours} ساعة", hours >= 24 ? "red" : "gold") %></span>
              <% end %>
            </td>
            <td><%= link_to (s.pending? ? "مراجعة" : "عرض"), admin_subscription_path(s), class: "btn btn-sm #{s.pending? ? 'btn-gold' : 'btn-ghost'}" %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <%= empty_state("لا توجد نتائج.") %>
  <% end %>
</div>
<%= render "admin/shared/pagination", meta: @meta %>
