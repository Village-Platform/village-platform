<% s = @subscription %>
<%= page_header "طلب اشتراك ##{s.id}", subtitle: "#{s.user.name} — #{s.subscription_plan.name}" do %>
  <%= enum_badge(Subscription, :status, s.status) %>
  <%= link_to edit_admin_subscription_path(s), class: "btn btn-ghost" do %><%= icon(:edit, size: 16) %> تعديل<% end %>
  <%= button_to admin_subscription_path(s), method: :delete, class: "btn btn-danger",
        form: { data: { confirm: "هل أنت متأكد من حذف هذا الاشتراك نهائياً؟" } } do %><%= icon(:trash, size: 16) %> حذف<% end %>
  <%= link_to admin_subscriptions_path, class: "btn btn-ghost" do %><%= icon(:arrow_left, size: 16) %> رجوع<% end %>
<% end %>

<% if s.pending? %>
  <section class="card review-box">
    <div class="card-header"><h2>المراجعة</h2></div>
    <p>تأكد من وصول تحويل <strong><%= egp(s.amount_cents) %></strong> عبر
      <strong><%= enum_label(Subscription, :payment_method, s.payment_method) %></strong>
      برقم العملية <strong class="ltr"><%= s.transaction_reference %></strong> قبل الاعتماد.</p>
    <div class="grid grid-2">
      <div>
        <%= button_to approve_admin_subscription_path(s), method: :patch, class: "btn",
              form: { data: { confirm: "اعتماد هذا الاشتراك؟ سيتم تفعيله وإشعار صاحب النشاط." } } do %>
          <%= icon(:check) %> اعتماد الاشتراك
        <% end %>
        <p><small>يبدأ الاشتراك فورًا، أو بعد انتهاء الاشتراك الحالي إن وُجد.</small></p>
      </div>
      <%= form_with url: reject_admin_subscription_path(s), method: :patch, data: { confirm: "رفض هذا الطلب؟" } do |f| %>
        <div class="field">
          <%= f.label :reason, "سبب الرفض" %>
          <%= f.text_area :reason, required: true, rows: 2, placeholder: "مثال: لم يصل التحويل" %>
        </div>
        <%= button_tag type: "submit", class: "btn btn-danger" do %><%= icon(:close) %> رفض الطلب<% end %>
      <% end %>
    </div>
  </section>
<% end %>

<div class="grid grid-2 mt">
  <section class="card">
    <div class="card-header"><h2>التفاصيل</h2></div>
    <dl class="details">
      <dt>صاحب الطلب</dt><dd><%= link_to s.user.name, admin_user_path(s.user) %> — <span class="ltr"><%= s.user.phone %></span></dd>
      <dt>الباقة</dt><dd><%= link_to s.subscription_plan.name, admin_subscription_plan_path(s.subscription_plan) %> (<%= s.subscription_plan.duration_days %> يوم، حتى <%= s.subscription_plan.max_firms %> نشاط)</dd>
      <dt>المبلغ</dt><dd><%= egp(s.amount_cents) %></dd>
      <dt>طريقة الدفع</dt><dd><%= enum_label(Subscription, :payment_method, s.payment_method) %></dd>
      <dt>رقم العملية</dt><dd class="ltr"><%= s.transaction_reference %></dd>
      <dt>رقم المحوِّل</dt><dd class="ltr"><%= s.payer_phone.presence || "—" %></dd>
      <dt>ملاحظات</dt><dd><%= s.notes.presence || "—" %></dd>
      <dt>الوضع الحالي</dt><dd><%= enum_badge(Subscription, :state, s.state) %></dd>
      <dt>يبدأ في</dt><dd><%= fmt_time(s.starts_at) %></dd>
      <dt>ينتهي في</dt><dd><%= fmt_time(s.ends_at) %></dd>
      <dt>تاريخ الطلب</dt><dd><%= fmt_time(s.created_at) %></dd>
      <% if s.reviewed_at %>
        <dt>تمت المراجعة</dt><dd><%= fmt_time(s.reviewed_at) %> — <%= s.reviewed_by&.name %></dd>
      <% end %>
      <% if s.rejection_reason.present? %>
        <dt>سبب الرفض</dt><dd class="text-bad"><%= s.rejection_reason %></dd>
      <% end %>
    </dl>
  </section>

  <section class="card">
    <div class="card-header"><h2>صورة التحويل</h2></div>
    <% if s.payment_screenshot.attached? %>
      <a href="<%= screenshot_admin_subscription_path(s) %>" target="_blank" rel="noopener" title="فتح بالحجم الكامل">
        <img class="screenshot" src="<%= screenshot_admin_subscription_path(s) %>" alt="صورة التحويل" loading="lazy">
      </a>
    <% else %>
      <%= empty_state("لم يرفق صاحب الطلب صورة.") %>
    <% end %>
  </section>
</div>
