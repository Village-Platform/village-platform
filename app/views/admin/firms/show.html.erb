<%= page_header @firm.name, subtitle: @firm.category.name do %>
  <%= enum_badge(Firm, :status, @firm.status) %>
  <% unless @firm.active? %>
    <%= button_to approve_admin_firm_path(@firm), method: :patch, class: "btn" do %><%= icon(:check, size: 16) %> اعتماد<% end %>
  <% end %>
  <% unless @firm.suspended? %>
    <%= button_to suspend_admin_firm_path(@firm), method: :patch, class: "btn btn-ghost",
          form: { data: { confirm: "إيقاف النشاط وإخفاؤه من التطبيق؟" } } do %><%= icon(:close, size: 16) %> إيقاف<% end %>
  <% end %>
  <%= link_to edit_admin_firm_path(@firm), class: "btn btn-ghost" do %><%= icon(:edit, size: 16) %> تعديل<% end %>
  <%= button_to admin_firm_path(@firm), method: :delete, class: "btn btn-danger",
        form: { data: { confirm: "حذف النشاط نهائيًا؟" } } do %><%= icon(:trash, size: 16) %> حذف<% end %>
<% end %>

<section class="card">
  <dl class="details">
    <dt>ظاهر للجمهور</dt>
    <dd>
      <%= yes_no_badge(@visible) %>
      <% unless @visible %><small>تظهر فقط إذا كانت مفعّلة واشتراك المالك ساري.</small><% end %>
    </dd>
    <dt>المالك</dt><dd><%= link_to @firm.owner.name, admin_user_path(@firm.owner) %> — <span class="ltr"><%= @firm.owner.phone %></span></dd>
    <dt>الهاتف</dt><dd class="ltr"><%= @firm.phone.presence || "—" %></dd>
    <dt>واتساب</dt><dd class="ltr"><%= @firm.whatsapp.presence || "—" %></dd>
    <dt>العنوان</dt><dd><%= @firm.address.presence || "—" %></dd>
    <dt>مواعيد العمل</dt><dd><%= @firm.working_hours.presence || "—" %></dd>
    <dt>الموقع</dt>
    <dd>
      <% if @firm.latitude && @firm.longitude %>
        <%= link_to "https://maps.google.com/?q=#{@firm.latitude},#{@firm.longitude}", target: "_blank", rel: "noopener" do %>
          <%= icon(:map, size: 16) %> فتح على الخريطة
        <% end %>
      <% else %>—<% end %>
    </dd>
    <dt>الوصف</dt><dd><%= simple_format(@firm.description.presence || "—") %></dd>
    <dt>تاريخ الإضافة</dt><dd><%= fmt_time(@firm.created_at) %></dd>
  </dl>
</section>

<section class="card mt">
  <div class="card-header"><h2>الصور والفيديو</h2></div>
  <% media = @firm.media.includes(file_attachment: :blob) %>
  <% if media.any? %>
    <div class="media-grid">
      <% media.each do |medium| %>
        <figure class="media-tile">
          <% if medium.image? %>
            <%= image_tag url_for(medium.file), alt: medium.caption.to_s, loading: "lazy" %>
          <% else %>
            <%= video_tag url_for(medium.file), controls: true, preload: "none" %>
          <% end %>
          <figcaption>
            <%= badge(medium.image? ? "صورة" : "فيديو") %>
            <span><%= medium.caption %></span>
            <%= button_to admin_firm_medium_path(@firm, medium), method: :delete, class: "btn btn-ghost btn-sm", title: "حذف",
                  form: { data: { confirm: "حذف الملف نهائيًا؟" } } do %><%= icon(:trash, size: 16) %><% end %>
          </figcaption>
        </figure>
      <% end %>
    </div>
  <% else %>
    <%= empty_state("لا توجد صور أو فيديو.") %>
  <% end %>
  <%= form_with url: admin_firm_media_path(@firm), multipart: true, class: "flex flex-wrap gap-2 items-center mt" do |f| %>
    <%= f.file_field :file, accept: MediaProfile.fetch(:firm_image).content_types.join(","), required: true, "aria-label": "صورة" %>
    <%= f.text_field :caption, placeholder: "وصف قصير (اختياري)", maxlength: 200, class: "w-52", "aria-label": "الوصف" %>
    <%= f.button type: "submit", class: "btn btn-ghost" do %><%= icon(:image, size: 16) %> إضافة صورة<% end %>
  <% end %>
</section>

<%= render "admin/shared/history", record: @firm %>
