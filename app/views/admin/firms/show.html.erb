<%= page_header @firm.name, subtitle: @firm.category.name do %>
  <% if @firm.deleted? %>
    <%= badge("محذوف", "red") %>
    <%= button_to restore_admin_firm_path(@firm), method: :patch, class: "btn btn-gold" do %>
      <%= icon(:restore, size: 16) %> استعادة النشاط
    <% end %>
    <%= button_to destroy_fully_admin_firm_path(@firm), method: :delete, class: "btn btn-danger",
          form: { data: { confirm: "هل أنت متأكد من الحذف النهائي للنشاط؟ لا يمكن التراجع عن هذا الإجراء!" } } do %>
      <%= icon(:trash, size: 16) %> حذف نهائي
    <% end %>
  <% else %>
    <%= enum_badge(Firm, :status, @firm.status) %>
    <% unless @firm.active? %>
      <%= button_to approve_admin_firm_path(@firm), method: :patch, class: "btn" do %><%= icon(:check, size: 16) %> اعتماد<% end %>
    <% end %>
    <% unless @firm.suspended? %>
      <%= button_to suspend_admin_firm_path(@firm), method: :patch, class: "btn btn-ghost",
            form: { data: { confirm: "إيقاف النشاط وإخفاؤه من التطبيق؟" } } do %><%= icon(:close, size: 16) %> إيقاف<% end %>
    <% end %>
    <%= link_to edit_admin_firm_path(@firm), class: "btn btn-ghost" do %><%= icon(:edit, size: 16) %> تعديل<% end %>
    <%= button_to admin_firm_path(@firm), method: :delete, class: "btn btn-danger",
          form: { data: { confirm: "نقل النشاط إلى سلة المحذوفات؟" } } do %><%= icon(:trash, size: 16) %> حذف<% end %>
  <% end %>
<% end %>

<% if @firm.deleted? %>
  <div class="card mb-4 border-r-4 border-bad bg-bad/10 p-4 flex flex-wrap items-center justify-between gap-3">
    <div class="flex items-center gap-3">
      <span class="badge badge-red text-xs">نشاط محذوف</span>
      <span class="text-xs">تم حذف هذا النشاط بتاريخ <%= fmt_time(@firm.deleted_at) %> (<%= time_ago_in_words(@firm.deleted_at) %>).</span>
    </div>
    <div class="flex items-center gap-2">
      <%= button_to restore_admin_firm_path(@firm), method: :patch, class: "btn btn-sm btn-gold" do %>
        <%= icon(:restore, size: 14) %> استعادة النشاط
      <% end %>
      <%= button_to destroy_fully_admin_firm_path(@firm), method: :delete, class: "btn btn-sm btn-danger",
            form: { data: { confirm: "هل أنت متأكد من الحذف النهائي للنشاط؟ لا يمكن التراجع عن هذا الإجراء!" } } do %>
        <%= icon(:trash, size: 14) %> حذف نهائي
      <% end %>
    </div>
  </div>
<% end %>

<section class="card">
  <dl class="details">
    <dt>ظاهر للجمهور</dt>
    <dd>
      <%= yes_no_badge(!@firm.deleted? && @visible) %>
      <% if @firm.deleted? %>
        <small class="text-bad">النشاط في سلة المحذوفات ومخفي تماماً عن الجمهور.</small>
      <% elsif !@visible %>
        <small>تظهر فقط إذا كانت مفعّلة واشتراك المالك ساري.</small>
      <% end %>
    </dd>
    <dt>المالك</dt><dd><%= link_to @firm.owner.name, admin_user_path(@firm.owner) %> — <span class="ltr"><%= @firm.owner.phone %></span></dd>
    <dt>الهاتف</dt><dd class="ltr"><%= @firm.phone.presence || "—" %></dd>
    <dt>واتساب</dt><dd class="ltr"><%= @firm.whatsapp.presence || "—" %></dd>
    <dt>العنوان</dt><dd><%= @firm.address.presence || "—" %></dd>
    <dt>مواعيد العمل</dt><dd><%= @firm.working_hours.presence || "—" %></dd>
    <dt>الموقع</dt>
    <dd>
      <% if @firm.latitude && @firm.longitude %>
        <%= link_to "https://maps.google.com/?q=#{@firm.latitude},#{@firm.longitude}", target: "_blank", rel: "noopener" do %>
          <%= icon(:map, size: 16) %> فتح على الخريطة
        <% end %>
      <% else %>—<% end %>
    </dd>
    <dt>الوصف</dt><dd><%= simple_format(@firm.description.presence || "—") %></dd>
    <dt>تاريخ الإضافة</dt><dd><%= fmt_time(@firm.created_at) %></dd>
    <% if @firm.deleted? %>
      <dt>تاريخ الحذف</dt><dd class="text-bad"><%= fmt_time(@firm.deleted_at) %> (<%= time_ago_in_words(@firm.deleted_at) %>)</dd>
    <% end %>
  </dl>
</section>
