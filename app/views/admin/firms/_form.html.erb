<%= form_with model: [:admin, firm], class: "form card" do |f| %>
  <%= render "admin/shared/errors", record: firm %>
  <div class="form-grid">
    <div class="field full"><%= f.label :name, "اسم النشاط" %><%= f.text_field :name, required: true %></div>
    <div class="field">
      <%= f.label :category_id, "التصنيف" %>
      <%= f.collection_select :category_id, @categories, :id, :name, { include_blank: "اختر التصنيف" }, required: true %>
    </div>
    <div class="field">
      <%= f.label :owner_id, "المالك" %>
      <%= f.collection_select :owner_id, @owners, :id, :name, { include_blank: "اختر المالك" }, required: true %>
      <div class="hint">أصحاب الأنشطة ومديرو النظام فقط.</div>
    </div>
    <div class="field"><%= f.label :status, "الحالة" %><%= f.select :status, enum_options(Firm, :status) %></div>
    <div class="field"><%= f.label :working_hours, "مواعيد العمل" %><%= f.text_field :working_hours, placeholder: "يوميًا ٩ص - ١١م" %></div>
    <div class="field"><%= f.label :phone, "الهاتف" %><%= f.telephone_field :phone %></div>
    <div class="field"><%= f.label :whatsapp, "واتساب" %><%= f.telephone_field :whatsapp %></div>
    <div class="field full"><%= f.label :address, "العنوان" %><%= f.text_field :address %></div>
    <div class="field"><%= f.label :latitude, "خط العرض" %><%= f.number_field :latitude, step: "any" %></div>
    <div class="field"><%= f.label :longitude, "خط الطول" %><%= f.number_field :longitude, step: "any" %></div>
    <div class="field full"><%= f.label :description, "الوصف" %><%= f.text_area :description %></div>
    <% firm.category&.fields&.each do |field| %>
      <% name = "firm[custom_fields][#{field.key}]" %>
      <% value = firm.custom_fields[field.key] %>
      <div class="field">
        <%= label_tag "custom_#{field.key}", field.label + (field.required ? " *" : "") %>
        <% case field.kind %>
        <% when "boolean" %>
          <%= select_tag name, options_for_select([ [ "—", "" ], [ "نعم", "true" ], [ "لا", "false" ] ], value.to_s), id: "custom_#{field.key}" %>
        <% when "choice" %>
          <%= select_tag name, options_for_select(field.options, value), include_blank: "—", id: "custom_#{field.key}" %>
        <% when "number" %>
          <%= number_field_tag name, value, step: "any", id: "custom_#{field.key}" %>
        <% else %>
          <%= text_field_tag name, value, maxlength: 200, id: "custom_#{field.key}" %>
        <% end %>
      </div>
    <% end %>
  </div>
  <div class="form-actions">
    <%= f.submit "حفظ", class: "btn" %>
    <%= link_to "إلغاء", firm.persisted? ? admin_firm_path(firm) : admin_firms_path, class: "btn btn-ghost" %>
  </div>
<% end %>
