<%= page_header "الأنشطة", subtitle: "#{@meta[:total]} نشاطاً في #{@categories.size} تصنيفاً" do %>
  <%= link_to new_admin_firm_path, class: "btn" do %><%= icon(:plus, size: 16) %> إضافة نشاط<% end %>
<% end %>

<div class="flex flex-wrap gap-2 items-center">
  <%= filter_tabs :status, enum_options(Firm, :status) %>
  <div class="flex-1"></div>
  <%= form_with url: admin_firms_path, method: :get, class: "flex flex-wrap gap-2 items-center" do |f| %>
    <%= f.hidden_field :status, value: params[:status] %>
    <%= search_combobox("firms") do |attrs| %>
      <%= f.search_field :q, value: params[:q], placeholder: "اسم النشاط", class: "w-44", "aria-label": "بحث", **attrs %>
    <% end %>
    <%= f.select :category_id,
          options_from_collection_for_select(@categories, :id, :name, params[:category_id]),
          { include_blank: "كل التصنيفات" }, { class: "w-40", "aria-label": "التصنيف" } %>
    <%= button_tag type: "submit", class: "btn btn-ghost", name: nil, title: "تصفية" do %><%= icon(:search, size: 16) %><% end %>
  <% end %>
  <% if current_admin.can?("export.run") %>
    <%= link_to "تصدير CSV", url_for(filter_params(page: nil, format: :csv)), class: "btn btn-ghost" %>
  <% end %>
</div>

<div class="tbl">
  <% if @firms.any? %>
    <table>
      <thead><tr><th>النشاط</th><th>التصنيف</th><th>المالك</th><th>ظاهر</th><th>الحالة</th><th>إجراءات</th></tr></thead>
      <tbody>
        <% @firms.each do |firm| %>
          <tr>
            <td><%= link_to firm.name, admin_firm_path(firm), class: "cell-main" %><span class="cell-sub ltr"><%= firm.phone %></span></td>
            <td><%= firm.category.name %></td>
            <td><%= firm.owner.name %></td>
            <td><%= switch(@visible_ids.include?(firm.id)) %></td>
            <td><%= enum_badge(Firm, :status, firm.status) %></td>
            <td class="actions">
              <% unless firm.active? %>
                <%= button_to "اعتماد", approve_admin_firm_path(firm), method: :patch, class: "btn btn-sm" %>
              <% end %>
              <% unless firm.suspended? %>
                <%= button_to "إيقاف", suspend_admin_firm_path(firm), method: :patch, class: "btn btn-ghost btn-sm",
                      form: { data: { confirm: "إيقاف النشاط وإخفاؤه من التطبيق؟" } } %>
              <% end %>
              <%= link_to edit_admin_firm_path(firm), class: "btn btn-ghost btn-sm", title: "تعديل" do %><%= icon(:edit, size: 14) %><% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <%= empty_state("لا توجد نتائج.") %>
  <% end %>
</div>
<%= render "admin/shared/pagination", meta: @meta %>
