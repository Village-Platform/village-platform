<%= page_header "المنشآت", subtitle: "الأطباء والمطاعم والمحلات وكل خدمات القرية" do %>
  <%= link_to new_admin_firm_path, class: "btn btn-gold" do %><%= icon(:plus, size: 18) %> إضافة منشأة<% end %>
<% end %>

<%= form_with url: admin_firms_path, method: :get, class: "filters" do |f| %>
  <div class="field search"><%= f.label :q, "بحث" %><%= f.search_field :q, value: params[:q], placeholder: "اسم المنشأة" %></div>
  <div class="field">
    <%= f.label :status, "الحالة" %>
    <%= f.select :status, options_for_select(enum_options(Firm, :status), params[:status]), include_blank: "الكل" %>
  </div>
  <div class="field">
    <%= f.label :category_id, "القسم" %>
    <%= f.select :category_id, options_from_collection_for_select(@categories, :id, :name, params[:category_id]), include_blank: "الكل" %>
  </div>
  <%= button_tag type: "submit", class: "btn", name: nil do %><%= icon(:search, size: 18) %> تصفية<% end %>
<% end %>

<div class="table-wrap">
  <% if @firms.any? %>
    <table>
      <thead><tr><th>المنشأة</th><th>القسم</th><th>المالك</th><th>الحالة</th><th>ظاهرة للجمهور</th><th></th></tr></thead>
      <tbody>
        <% @firms.each do |firm| %>
          <tr>
            <td><%= link_to firm.name, admin_firm_path(firm), class: "cell-main" %><span class="cell-sub ltr"><%= firm.phone %></span></td>
            <td><%= firm.category.name %></td>
            <td><%= firm.owner.name %></td>
            <td><%= enum_badge(Firm, :status, firm.status) %></td>
            <td><%= yes_no_badge(@visible_ids.include?(firm.id)) %></td>
            <td class="actions">
              <% unless firm.active? %>
                <%= button_to "اعتماد", approve_admin_firm_path(firm), method: :patch, class: "btn btn-sm" %>
              <% end %>
              <% unless firm.suspended? %>
                <%= button_to "إيقاف", suspend_admin_firm_path(firm), method: :patch, class: "btn btn-ghost btn-sm",
                      form: { data: { confirm: "إيقاف المنشأة وإخفاؤها من التطبيق؟" } } %>
              <% end %>
              <%= link_to edit_admin_firm_path(firm), class: "btn btn-ghost btn-sm", title: "تعديل" do %><%= icon(:edit, size: 16) %><% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <%= empty_state("لا توجد نتائج.") %>
  <% end %>
</div>
<%= render "admin/shared/pagination", meta: @meta %>
