<%= page_header "التصنيفات", subtitle: "تظهر في الصفحة الرئيسية للتطبيق بنفس الترتيب" do %>
  <%= link_to new_admin_category_path, class: "btn btn-gold" do %><%= icon(:plus, size: 18) %> إضافة تصنيف<% end %>
<% end %>

<div class="flex flex-wrap gap-2 items-center justify-between mb-4">
  <%= form_with url: admin_categories_path, method: :get, class: "flex flex-wrap gap-2 items-center" do |f| %>
    <%= f.search_field :q, value: params[:q], placeholder: "ابحث في التصنيفات...", class: "w-56 input", "aria-label": "بحث" %>
    <%= f.select :active, [["الكل", ""], ["المفعّلة", "true"], ["المعطلة", "false"]], { selected: params[:active] }, { class: "w-36 select", "aria-label": "الحالة" } %>
    <%= button_tag type: "submit", class: "btn btn-ghost", name: nil, title: "تصفية" do %><%= icon(:search, size: 16) %><% end %>
    <% if params[:q].present? || params[:active].present? %>
      <%= link_to "إلغاء الفلاتر", admin_categories_path, class: "btn btn-ghost btn-sm text-xs" %>
    <% end %>
  <% end %>
</div>

<%= advanced_filter(url: admin_categories_path, carry: %i[ q active ]) do |f| %>
  <%= filter_text f, :name_cont, "الاسم" %>
  <%= filter_text f, :description_cont, "الوصف" %>
<% end %>

<div class="tbl">
  <% if @categories.any? %>
    <table>
      <thead>
        <tr>
          <%= sortable_th "الترتيب", :position %>
          <th>الأيقونة</th>
          <%= sortable_th "التصنيف", :name %>
          <th>عدد الأنشطة</th>
          <%= sortable_th "مفعّل", :active %>
          <th>إجراءات</th>
        </tr>
      </thead>
      <tbody>
        <% @categories.each do |category| %>
          <tr>
            <td><%= category.position %></td>
            <td>
              <% if category.icon_image.attached? %>
                <%= image_tag url_for(category.icon_image), class: "cat-icon", alt: "" %>
              <% else %>
                <span class="cell-sub">—</span>
              <% end %>
            </td>
            <td>
              <%= link_to category.name, admin_category_path(category), class: "cell-main" %>
              <% if category.description.present? %><span class="cell-sub"><%= truncate(category.description, length: 60) %></span><% end %>
            </td>
            <td><%= link_to @firm_counts.fetch(category.id, 0), admin_firms_path(category_id: category.id), class: "badge badge-gray hover:text-ink" %></td>
            <td>
              <%= button_to toggle_admin_category_path(category), method: :patch, class: "switch-btn", title: "تغيير حالة التفعيل" do %>
                <%= switch(category.active) %>
              <% end %>
            </td>
            <td class="actions">
              <%= link_to admin_category_path(category), class: "btn btn-ghost btn-sm", title: "عرض" do %><%= icon(:eye, size: 16) %><% end %>
              <%= link_to edit_admin_category_path(category), class: "btn btn-ghost btn-sm", title: "تعديل" do %><%= icon(:edit, size: 16) %><% end %>
              <%= button_to admin_category_path(category), method: :delete, class: "btn btn-ghost btn-sm text-bad", title: "حذف",
                    form: { data: { confirm: "حذف التصنيف؟" } } do %><%= icon(:trash, size: 16) %><% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <%= empty_state("لا توجد تصنيفات بعد.") %>
  <% end %>
</div>
