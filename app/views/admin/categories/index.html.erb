<% content_for :title, "الأقسام" %>
<div class="page-header">
  <h1>الأقسام</h1>
  <%= link_to "إضافة قسم", new_admin_category_path, class: "btn btn-gold" %>
</div>
<div class="table-wrap">
  <% if @categories.any? %>
    <table>
      <thead><tr><th>الترتيب</th><th>الاسم</th><th>عدد المنشآت</th><th>مفعّل</th><th></th></tr></thead>
      <tbody>
        <% @categories.each do |category| %>
          <tr>
            <td><%= category.position %></td>
            <td><%= link_to category.name, admin_firms_path(category_id: category.id) %></td>
            <td><%= @firm_counts.fetch(category.id, 0) %></td>
            <td><%= yes_no_badge(category.active) %></td>
            <td class="actions">
              <%= link_to "تعديل", edit_admin_category_path(category), class: "btn btn-ghost btn-sm" %>
              <%= button_to "حذف", admin_category_path(category), method: :delete, class: "btn btn-danger btn-sm",
                    form: { data: { confirm: "حذف القسم؟" } } %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p class="empty">لا توجد أقسام.</p>
  <% end %>
</div>
