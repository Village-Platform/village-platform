<%= page_header @article.title, subtitle: enum_label(Article, :kind, @article.kind) do %>
  <% if @article.deleted? %>
    <%= badge("محذوف", "red") %>
    <%= button_to restore_admin_article_path(@article), method: :patch, class: "btn btn-gold" do %>
      <%= icon(:restore, size: 16) %> استعادة المقال
    <% end %>
    <%= button_to destroy_fully_admin_article_path(@article), method: :delete, class: "btn btn-danger",
          form: { data: { confirm: "هل أنت متأكد من الحذف النهائي للمقال؟ لا يمكن التراجع عن هذا الإجراء!" } } do %>
      <%= icon(:trash, size: 16) %> حذف نهائي
    <% end %>
  <% else %>
    <%= link_to edit_admin_article_path(@article), class: "btn btn-ghost" do %><%= icon(:edit, size: 16) %> تعديل<% end %>
    <%= button_to admin_article_path(@article), method: :delete, class: "btn btn-danger",
          form: { data: { confirm: "نقل هذا المقال إلى سلة المحذوفات؟" } } do %><%= icon(:trash, size: 16) %> حذف<% end %>
  <% end %>
  <%= link_to admin_articles_path, class: "btn btn-ghost" do %><%= icon(:arrow_left, size: 16) %> العودة للقائمة<% end %>
<% end %>

<% if @article.deleted? %>
  <div class="card mb-4 border-r-4 border-bad bg-bad/10 p-4 flex flex-wrap items-center justify-between gap-3">
    <div class="flex items-center gap-3">
      <span class="badge badge-red text-xs">مقال محذوف</span>
      <span class="text-xs">تم حذف هذا المقال بتاريخ <%= fmt_time(@article.deleted_at) %> (<%= time_ago_in_words(@article.deleted_at) %>).</span>
    </div>
    <div class="flex items-center gap-2">
      <%= button_to restore_admin_article_path(@article), method: :patch, class: "btn btn-sm btn-gold" do %>
        <%= icon(:restore, size: 14) %> استعادة
      <% end %>
      <%= button_to destroy_fully_admin_article_path(@article), method: :delete, class: "btn btn-sm btn-danger",
            form: { data: { confirm: "هل أنت متأكد من الحذف النهائي؟" } } do %>
        <%= icon(:trash, size: 14) %> حذف نهائي
      <% end %>
    </div>
  </div>
<% end %>

<section class="card mb-4">
  <div class="card-header"><h2>تفاصيل المقال</h2></div>
  <dl class="details">
    <dt>النوع</dt><dd><%= enum_badge(Article, :kind, @article.kind) %></dd>
    <dt>حالة النشر</dt>
    <dd>
      <% if @article.published_at.nil? %>
        <%= badge("مسودة") %>
      <% elsif @article.published? %>
        <%= badge("منشور", "green") %> <span class="text-xs text-muted"><%= fmt_time(@article.published_at) %></span>
      <% else %>
        <%= badge("مجدول", "gold") %> <span class="text-xs text-muted"><%= fmt_time(@article.published_at) %></span>
      <% end %>
    </dd>
    <dt>الكاتب</dt><dd><%= link_to @article.author.name, admin_user_path(@article.author) %></dd>
    <dt>تاريخ الإنشاء</dt><dd><%= fmt_time(@article.created_at) %></dd>
    <% if @article.deleted? %>
      <dt>تاريخ الحذف</dt><dd class="text-bad"><%= fmt_time(@article.deleted_at) %> (<%= time_ago_in_words(@article.deleted_at) %>)</dd>
    <% end %>
  </dl>
</section>

<section class="card">
  <div class="card-header"><h2>المحتوى</h2></div>
  <div class="prose max-w-none text-sm leading-relaxed p-2 whitespace-pre-wrap">
    <%= @article.body %>
  </div>
</section>
