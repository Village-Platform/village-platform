<%= page_header "الأخبار والإعلانات", subtitle: "تظهر لكل مستخدمي التطبيق" do %>
  <%= link_to new_admin_article_path, class: "btn btn-gold" do %><%= icon(:plus, size: 18) %> إضافة خبر<% end %>
<% end %>

<%= form_with url: admin_articles_path, method: :get, class: "filters" do |f| %>
  <div class="field search"><%= f.label :q, "بحث" %><%= f.search_field :q, value: params[:q], placeholder: "العنوان" %></div>
  <div class="field">
    <%= f.label :kind, "النوع" %>
    <%= f.select :kind, options_for_select(enum_options(Article, :kind), params[:kind]), include_blank: "الكل" %>
  </div>
  <%= button_tag type: "submit", class: "btn", name: nil do %><%= icon(:search, size: 18) %> تصفية<% end %>
<% end %>

<div class="table-wrap">
  <% if @articles.any? %>
    <table>
      <thead><tr><th>العنوان</th><th>النوع</th><th>النشر</th><th>الكاتب</th><th></th></tr></thead>
      <tbody>
        <% @articles.each do |article| %>
          <tr>
            <td><%= link_to truncate(article.title, length: 60), edit_admin_article_path(article), class: "cell-main" %></td>
            <td><%= enum_badge(Article, :kind, article.kind) %></td>
            <td>
              <% if article.published_at.nil? %>
                <%= badge("مسودة") %>
              <% elsif article.published? %>
                <%= badge("منشور", "green") %> <small><%= fmt_date(article.published_at) %></small>
              <% else %>
                <%= badge("مجدول", "gold") %> <small><%= fmt_time(article.published_at) %></small>
              <% end %>
            </td>
            <td><%= article.author.name %></td>
            <td class="actions">
              <%= link_to edit_admin_article_path(article), class: "btn btn-ghost btn-sm", title: "تعديل" do %><%= icon(:edit, size: 16) %><% end %>
              <%= button_to admin_article_path(article), method: :delete, class: "btn btn-ghost btn-sm", title: "حذف",
                    form: { data: { confirm: "حذف الخبر؟" } } do %><%= icon(:trash, size: 16) %><% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <%= empty_state("لا توجد أخبار بعد.") %>
  <% end %>
</div>
<%= render "admin/shared/pagination", meta: @meta %>
