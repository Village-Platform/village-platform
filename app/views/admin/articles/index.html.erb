<% content_for :title, "الأخبار" %>
<div class="page-header">
  <h1>الأخبار والإعلانات</h1>
  <%= link_to "إضافة خبر", new_admin_article_path, class: "btn btn-gold" %>
</div>

<%= form_with url: admin_articles_path, method: :get, class: "filters" do |f| %>
  <div class="field"><%= f.label :q, "بحث" %><%= f.search_field :q, value: params[:q], placeholder: "العنوان" %></div>
  <div class="field">
    <%= f.label :kind, "النوع" %>
    <%= f.select :kind, options_for_select(enum_options(Article, :kind), params[:kind]), include_blank: "الكل" %>
  </div>
  <%= f.submit "تصفية", class: "btn" %>
<% end %>

<div class="table-wrap">
  <% if @articles.any? %>
    <table>
      <thead><tr><th>العنوان</th><th>النوع</th><th>النشر</th><th>الكاتب</th><th></th></tr></thead>
      <tbody>
        <% @articles.each do |article| %>
          <tr>
            <td><%= link_to article.title, edit_admin_article_path(article) %></td>
            <td><%= enum_badge(Article, :kind, article.kind) %></td>
            <td>
              <% if article.published_at.nil? %>
                <%= badge("مسودة") %>
              <% elsif article.published? %>
                <%= badge("منشور", "success") %> <small><%= fmt_date(article.published_at) %></small>
              <% else %>
                <%= badge("مجدول", "info") %> <small><%= fmt_time(article.published_at) %></small>
              <% end %>
            </td>
            <td><%= article.author.name %></td>
            <td class="actions">
              <%= link_to "تعديل", edit_admin_article_path(article), class: "btn btn-ghost btn-sm" %>
              <%= button_to "حذف", admin_article_path(article), method: :delete, class: "btn btn-danger btn-sm",
                    form: { data: { confirm: "حذف الخبر؟" } } %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p class="empty">لا توجد أخبار.</p>
  <% end %>
</div>
<%= render "admin/shared/pagination", meta: @meta %>
