<div class="auth">
  <section class="auth-panel">
    <div class="auth-card">
      <div class="logo"><%= brand_logo %></div>
      <h1>لوحة تحكم التطبيق</h1>
      <p class="subtitle"><%= t("admin.sessions.subtitle") %></p>

      <% flash.each do |type, message| %>
        <div class="flash flash-<%= type %>"><%= message %></div>
      <% end %>

      <%= form_with url: admin_login_path, method: :post do |f| %>
        <div class="field">
          <%= f.label :phone, t("admin.sessions.phone") %>
          <%= f.telephone_field :phone, required: true, autocomplete: "username", autofocus: true,
                inputmode: "tel", placeholder: "01xxxxxxxxx" %>
        </div>
        <div class="field">
          <%= f.label :password, t("admin.sessions.password") %>
          <%= f.password_field :password, required: true, autocomplete: "current-password" %>
        </div>
        <%= f.button t("admin.sessions.submit"), type: "submit", class: "btn" %>
      <% end %>

      <p class="auth-foot">مخصص لمديري النظام فقط</p>
    </div>
  </section>

  <aside class="auth-visual" aria-hidden="true">
    <h2>كل خدمات قريتك<br><span>في مكان واحد</span></h2>
    <p>أدر التصنيفات والأنشطة والأخبار واشتراكات أصحاب الأنشطة من مكان واحد.</p>
  </aside>
</div>
