<%= page_header @user.name, subtitle: @user.phone do %>
  <%= enum_badge(User, :role, @user.role) %>
  <%= link_to edit_admin_user_path(@user), class: "btn btn-ghost" do %><%= icon(:edit, size: 18) %> تعديل<% end %>
<% end %>

<div class="grid grid-2">
  <section class="card">
    <div class="card-header"><h2>البيانات</h2></div>
    <dl class="details">
      <dt>الهاتف</dt><dd class="ltr"><%= @user.phone %></dd>
      <dt>البريد</dt><dd class="ltr"><%= @user.email.presence || "—" %></dd>
      <dt>تاريخ التسجيل</dt><dd><%= fmt_time(@user.created_at) %></dd>
      <dt>الاشتراك الحالي</dt>
      <dd>
        <% if @current_subscription %>
          <%= @current_subscription.subscription_plan.name %> — حتى <%= fmt_date(@current_subscription.ends_at) %>
          (<%= @current_subscription.days_left %> يوم)
        <% else %>
          <%= badge("لا يوجد") %>
        <% end %>
      </dd>
    </dl>
  </section>

  <section class="card">
    <div class="card-header"><h2>الأنشطة</h2></div>
    <% if @firms.any? %>
      <ul>
        <% @firms.each do |firm| %>
          <li><%= link_to firm.name, admin_firm_path(firm) %> — <%= firm.category.name %> <%= enum_badge(Firm, :status, firm.status) %></li>
        <% end %>
      </ul>
    <% else %>
      <%= empty_state("لا توجد أنشطة.") %>
    <% end %>
  </section>
</div>

<section class="card mt">
  <div class="card-header"><h2>سجل الاشتراكات</h2></div>
  <% if @subscriptions.any? %>
    <div class="tbl">
      <table>
        <thead><tr><th>#</th><th>الباقة</th><th>المبلغ</th><th>الحالة</th><th>الوضع</th><th>من</th><th>إلى</th></tr></thead>
        <tbody>
          <% @subscriptions.each do |s| %>
            <tr>
              <td><%= link_to s.id, admin_subscription_path(s) %></td>
              <td><%= s.subscription_plan.name %></td>
              <td><%= egp(s.amount_cents) %></td>
              <td><%= enum_badge(Subscription, :status, s.status) %></td>
              <td><%= enum_badge(Subscription, :state, s.state) %></td>
              <td><%= fmt_date(s.starts_at) %></td>
              <td><%= fmt_date(s.ends_at) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <%= empty_state("لا توجد اشتراكات.") %>
  <% end %>
</section>

<% if @user.staff? && current_admin.super_admin? %>
  <section class="card mt">
    <div class="card-header"><h2>صلاحيات الموظف</h2></div>
    <%= form_with url: admin_user_permissions_path(@user), method: :patch do |f| %>
      <% granted = @user.staff_permissions.pluck(:permission) %>
      <div class="form-grid">
        <% StaffPermission::PERMISSIONS.each do |key, label| %>
          <div class="field checkbox">
            <%= check_box_tag "permissions[]", key, granted.include?(key), id: "perm-#{key.parameterize}" %>
            <%= label_tag "perm-#{key.parameterize}", label %>
          </div>
        <% end %>
      </div>
      <div class="form-actions"><%= f.submit "حفظ الصلاحيات", class: "btn btn-gold" %></div>
    <% end %>
  </section>
<% end %>

<%= render "admin/shared/history", record: @user %>
