<%= page_header "المستخدمون", :users, subtitle: "سكان القرية وأصحاب المنشآت ومديرو النظام" do %>
  <%= link_to new_admin_user_path, class: "btn btn-gold" do %><%= icon(:plus, size: 18) %> إضافة مستخدم<% end %>
<% end %>

<%= form_with url: admin_users_path, method: :get, class: "filters" do |f| %>
  <div class="field search"><%= f.label :q, "بحث" %><%= f.search_field :q, value: params[:q], placeholder: "الاسم أو الهاتف أو البريد" %></div>
  <div class="field">
    <%= f.label :role, "الصلاحية" %>
    <%= f.select :role, options_for_select(enum_options(User, :role), params[:role]), include_blank: "الكل" %>
  </div>
  <%= button_tag type: "submit", class: "btn", name: nil do %><%= icon(:search, size: 18) %> تصفية<% end %>
<% end %>

<div class="table-wrap">
  <% if @users.any? %>
    <table>
      <thead><tr><th>الاسم</th><th>الهاتف</th><th>البريد</th><th>الصلاحية</th><th>تاريخ التسجيل</th></tr></thead>
      <tbody>
        <% @users.each do |user| %>
          <tr>
            <td><span class="avatar" style="width:30px;height:30px;font-size:.8rem;display:inline-grid;margin-inline-end:8px"><%= initials(user.name) %></span><%= link_to user.name, admin_user_path(user), class: "cell-main" %></td>
            <td class="ltr"><%= user.phone %></td>
            <td class="ltr"><%= user.email.presence || "—" %></td>
            <td><%= enum_badge(User, :role, user.role) %></td>
            <td><%= fmt_date(user.created_at) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <%= empty_state("لا توجد نتائج.") %>
  <% end %>
</div>
<%= render "admin/shared/pagination", meta: @meta %>
