<%= page_header "المستخدمون", subtitle: "سكان القرية وأصحاب الأنشطة ومديرو النظام" do %>
  <%= link_to new_admin_user_path, class: "btn btn-gold" do %><%= icon(:plus, size: 18) %> إضافة مستخدم<% end %>
<% end %>

<div class="flex flex-wrap gap-2 items-center">
  <%= filter_tabs :role, enum_options(User, :role) %>
  <div class="flex-1"></div>
  <%= form_with url: admin_users_path, method: :get, class: "flex flex-wrap gap-2 items-center" do |f| %>
    <%= f.hidden_field :role, value: params[:role] %>
    <%= search_combobox("users") do |attrs| %>
      <%= f.search_field :q, value: params[:q], placeholder: "الاسم أو الهاتف أو البريد", class: "w-52", "aria-label": "بحث", **attrs %>
    <% end %>
    <%= button_tag type: "submit", class: "btn btn-ghost", name: nil, title: "تصفية" do %><%= icon(:search, size: 16) %><% end %>
  <% end %>
</div>

<div class="tbl">
  <% if @users.any? %>
    <table>
      <thead><tr><th>الاسم</th><th>الهاتف</th><th>البريد</th><th>الصلاحية</th><th>تاريخ التسجيل</th></tr></thead>
      <tbody>
        <% @users.each do |user| %>
          <tr>
            <td><span class="avatar" style="width:30px;height:30px;font-size:.8rem;display:inline-grid;margin-inline-end:8px"><%= initials(user.name) %></span><%= link_to user.name, admin_user_path(user), class: "cell-main" %></td>
            <td class="ltr"><%= user.phone %></td>
            <td class="ltr"><%= user.email.presence || "—" %></td>
            <td><%= enum_badge(User, :role, user.role) %></td>
            <td><%= fmt_date(user.created_at) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <%= empty_state("لا توجد نتائج.") %>
  <% end %>
</div>
<%= render "admin/shared/pagination", meta: @meta %>
