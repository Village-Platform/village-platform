<% content_for :title, "نظرة عامة" %>
<% content_for :subtitle, l(Date.current, format: :long) %>

<div class="stats">
  <%= link_to admin_users_path, class: "stat stat-hi" do %>
    <span class="label">إجمالي الأهالي</span>
    <span class="value"><%= @stats[:users] %></span>
  <% end %>
  <%= link_to admin_firms_path, class: "stat" do %>
    <span class="label">الأنشطة المسجلة</span>
    <span class="value"><%= @stats[:firms] %></span>
    <% if @stats[:pending_firms].positive? %>
      <span class="sub"><%= @stats[:pending_firms] %> بانتظار الموافقة</span>
    <% end %>
  <% end %>
  <%= link_to admin_subscriptions_path(status: "active"), class: "stat" do %>
    <span class="label">الاشتراكات الفعالة</span>
    <span class="value"><%= @stats[:current_subscriptions] %></span>
  <% end %>
  <%= link_to admin_articles_path, class: "stat" do %>
    <span class="label">المقالات المنشورة</span>
    <span class="value"><%= @stats[:published_articles] %></span>
  <% end %>
</div>

<div class="grid grid-2">
  <section class="card">
    <h2 class="mb-3">تحتاج إجراءك</h2>
    <%= link_to admin_subscriptions_path(status: "pending"), class: "todo-row" do %>
      <span class="flex-1">اشتراكات بانتظار المراجعة</span>
      <b class="count"><%= @stats[:pending_subscriptions] %></b>
    <% end %>
    <%= link_to admin_firms_path(status: "pending"), class: "todo-row" do %>
      <span class="flex-1">أنشطة بانتظار الموافقة</span>
      <b class="count"><%= @stats[:pending_firms] %></b>
    <% end %>
    <%= link_to admin_subscriptions_path(status: "active"), class: "todo-row" do %>
      <span class="flex-1">اشتراكات تنتهي هذا الأسبوع</span>
      <b class="count"><%= @stats[:expiring_soon] %></b>
    <% end %>
  </section>

  <section class="card">
    <h2 class="mb-3">الأنشطة حسب التصنيف</h2>
    <% if @firms_by_category.any? %>
      <% busiest = @firms_by_category.first.last %>
      <div class="bars">
        <% @firms_by_category.each do |name, count| %>
          <div class="bar-row">
            <div class="bar-head"><span><%= name %></span><b><%= count %></b></div>
            <div class="bar-track">
              <div class="bar-fill" style="width: <%= (count * 100.0 / busiest).round %>%"></div>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <%= empty_state("لا توجد أنشطة بعد") %>
    <% end %>
  </section>
</div>

<div class="grid grid-2">
  <section class="card">
    <div class="card-header">
      <h2>طلبات اشتراك تنتظر المراجعة</h2>
      <%= link_to "عرض الكل", admin_subscriptions_path(status: "pending") %>
    </div>
    <% if @pending.any? %>
      <div class="table-wrap">
        <table>
          <thead><tr><th>صاحب الطلب</th><th>الباقة</th><th>المبلغ</th><th>منذ</th></tr></thead>
          <tbody>
            <% @pending.each do |s| %>
              <tr>
                <td><%= link_to s.user.name, admin_subscription_path(s), class: "cell-main" %><span class="cell-sub ltr"><%= s.user.phone %></span></td>
                <td><%= s.subscription_plan.name %></td>
                <td><%= egp(s.amount_cents) %></td>
                <td><%= time_ago_in_words(s.created_at) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <%= empty_state("لا توجد طلبات جديدة") %>
    <% end %>
  </section>

  <section class="card">
    <div class="card-header">
      <h2>اشتراكات تنتهي خلال ٧ أيام</h2>
    </div>
    <% if @expiring.any? %>
      <div class="table-wrap">
        <table>
          <thead><tr><th>صاحب النشاط</th><th>الباقة</th><th>ينتهي في</th><th>متبقي</th></tr></thead>
          <tbody>
            <% @expiring.each do |s| %>
              <tr>
                <td><%= link_to s.user.name, admin_user_path(s.user), class: "cell-main" %></td>
                <td><%= s.subscription_plan.name %></td>
                <td><%= fmt_date(s.ends_at) %></td>
                <td><%= badge("#{s.days_left} يوم", s.days_left <= 1 ? "red" : "gold") %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <%= empty_state("لا توجد اشتراكات على وشك الانتهاء.") %>
    <% end %>
  </section>

  <section class="card">
    <div class="card-header">
      <h2>أنشطة تنتظر الاعتماد</h2>
      <%= link_to "عرض الكل", admin_firms_path(status: "pending") %>
    </div>
    <% if @pending_firms.any? %>
      <div class="table-wrap">
        <table>
          <thead><tr><th>النشاط</th><th>التصنيف</th><th>المالك</th><th></th></tr></thead>
          <tbody>
            <% @pending_firms.each do |firm| %>
              <tr>
                <td><%= link_to firm.name, admin_firm_path(firm), class: "cell-main" %></td>
                <td><%= firm.category.name %></td>
                <td><%= firm.owner.name %></td>
                <td><%= button_to "اعتماد", approve_admin_firm_path(firm), method: :patch, class: "btn btn-sm" %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <%= empty_state("لا توجد أنشطة جديدة.") %>
    <% end %>
  </section>
</div>
