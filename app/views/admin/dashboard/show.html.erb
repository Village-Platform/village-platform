<% content_for :title, "الرئيسية" %>

<section class="hero">
  <div>
    <h1>أهلاً <%= current_admin.name %></h1>
    <p>كل خدمات أجهور الكبرى في مكان واحد — راجع الطلبات الجديدة وتابع المنشآت والأخبار.</p>
    <div class="hero-actions">
      <%= link_to admin_subscriptions_path(status: "pending"), class: "btn btn-gold" do %>
        <%= icon(:subscriptions) %> مراجعة الاشتراكات
      <% end %>
      <%= link_to new_admin_article_path, class: "btn btn-light" do %>
        <%= icon(:plus) %> خبر جديد
      <% end %>
      <%= link_to new_admin_firm_path, class: "btn btn-light" do %>
        <%= icon(:plus) %> منشأة جديدة
      <% end %>
    </div>
  </div>
</section>

<div class="stats">
  <%= link_to admin_subscriptions_path(status: "pending"), class: "stat attention" do %>
    <span class="stat-icon"><%= icon(:clock, size: 22) %></span>
    <span><span class="value"><%= @stats[:pending_subscriptions] %></span><br><span class="label">اشتراكات قيد المراجعة</span></span>
  <% end %>
  <%= link_to admin_subscriptions_path(status: "active"), class: "stat" do %>
    <span class="stat-icon"><%= icon(:subscriptions, size: 22) %></span>
    <span><span class="value"><%= @stats[:current_subscriptions] %></span><br><span class="label">اشتراكات سارية</span></span>
  <% end %>
  <%= link_to admin_firms_path(status: "pending"), class: "stat attention" do %>
    <span class="stat-icon"><%= icon(:firms, size: 22) %></span>
    <span><span class="value"><%= @stats[:pending_firms] %></span><br><span class="label">منشآت تنتظر الاعتماد</span></span>
  <% end %>
  <%= link_to admin_firms_path(status: "active"), class: "stat" do %>
    <span class="stat-icon"><%= icon(:eye, size: 22) %></span>
    <span><span class="value"><%= @stats[:visible_firms] %></span><br><span class="label">منشآت ظاهرة للجمهور</span></span>
  <% end %>
  <%= link_to admin_users_path, class: "stat" do %>
    <span class="stat-icon"><%= icon(:users, size: 22) %></span>
    <span><span class="value"><%= @stats[:users] %></span><br><span class="label">المستخدمون</span></span>
  <% end %>
  <%= link_to admin_articles_path, class: "stat" do %>
    <span class="stat-icon"><%= icon(:articles, size: 22) %></span>
    <span><span class="value"><%= @stats[:published_articles] %></span><br><span class="label">أخبار منشورة</span></span>
  <% end %>
</div>

<div class="grid grid-2">
  <section class="card">
    <div class="card-header">
      <h2>طلبات اشتراك تنتظر المراجعة</h2>
      <%= link_to "عرض الكل", admin_subscriptions_path(status: "pending") %>
    </div>
    <% if @pending.any? %>
      <div class="table-wrap">
        <table>
          <thead><tr><th>صاحب الطلب</th><th>الباقة</th><th>المبلغ</th><th>منذ</th></tr></thead>
          <tbody>
            <% @pending.each do |s| %>
              <tr>
                <td><%= link_to s.user.name, admin_subscription_path(s), class: "cell-main" %><span class="cell-sub ltr"><%= s.user.phone %></span></td>
                <td><%= s.subscription_plan.name %></td>
                <td><%= egp(s.amount_cents) %></td>
                <td><%= time_ago_in_words(s.created_at) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <%= empty_state("لا توجد طلبات جديدة") %>
    <% end %>
  </section>

  <section class="card">
    <div class="card-header">
      <h2>اشتراكات تنتهي خلال ٧ أيام</h2>
    </div>
    <% if @expiring.any? %>
      <div class="table-wrap">
        <table>
          <thead><tr><th>صاحب المنشأة</th><th>الباقة</th><th>ينتهي في</th><th>متبقي</th></tr></thead>
          <tbody>
            <% @expiring.each do |s| %>
              <tr>
                <td><%= link_to s.user.name, admin_user_path(s.user), class: "cell-main" %></td>
                <td><%= s.subscription_plan.name %></td>
                <td><%= fmt_date(s.ends_at) %></td>
                <td><%= badge("#{s.days_left} يوم", s.days_left <= 1 ? "red" : "gold") %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <%= empty_state("لا توجد اشتراكات على وشك الانتهاء.") %>
    <% end %>
  </section>

  <section class="card">
    <div class="card-header">
      <h2>منشآت تنتظر الاعتماد</h2>
      <%= link_to "عرض الكل", admin_firms_path(status: "pending") %>
    </div>
    <% if @pending_firms.any? %>
      <div class="table-wrap">
        <table>
          <thead><tr><th>المنشأة</th><th>القسم</th><th>المالك</th><th></th></tr></thead>
          <tbody>
            <% @pending_firms.each do |firm| %>
              <tr>
                <td><%= link_to firm.name, admin_firm_path(firm), class: "cell-main" %></td>
                <td><%= firm.category.name %></td>
                <td><%= firm.owner.name %></td>
                <td><%= button_to "اعتماد", approve_admin_firm_path(firm), method: :patch, class: "btn btn-sm" %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <%= empty_state("لا توجد منشآت جديدة.") %>
    <% end %>
  </section>
</div>
