<%= page_header "إرسال إشعار لمستخدم", subtitle: "يصل لصندوق المستخدم ولكل أجهزته" do %>
  <%= link_to admin_notifications_path, class: "btn btn-ghost" do %><%= icon(:arrow_left, size: 16) %> رجوع للإشعارات<% end %>
<% end %>

<section class="card">
  <p class="cell-sub mb-3">
    للإرسال لكل المستخدمين أو لمجموعة منهم استخدم
    <%= link_to "حملة إشعارات", new_admin_notification_campaign_path %>.
  </p>
  <%= form_with url: admin_notifications_path, method: :post, class: "form" do |f| %>
    <div class="field">
      <%= f.label "notification[user_id]", "المستخدم المستلم" %>
      <%= select_tag "notification[user_id]",
            options_from_collection_for_select(@users, :id, ->(u) { "#{u.name} (#{u.phone})" }, params.dig(:notification, :user_id)),
            { prompt: "اختر المستخدم", class: "select w-full", required: true } %>
    </div>

    <div class="field">
      <%= f.label "notification[title]", "عنوان الإشعار" %>
      <%= text_field_tag "notification[title]", params.dig(:notification, :title),
            class: "input w-full", placeholder: "مثال: تحديث جديد في المنصة", required: true %>
    </div>

    <div class="field">
      <%= f.label "notification[body]", "نص الإشعار" %>
      <%= text_area_tag "notification[body]", params.dig(:notification, :body),
            rows: 4, class: "input w-full", placeholder: "اكتب رسالة الإشعار بالتفصيل...", required: true %>
    </div>

    <%= render "admin/notification_campaigns/destination_fields", scope: "notification",
          screen: params.dig(:notification, :screen) || "none", target_id: params.dig(:notification, :target_id) %>

    <div class="form-actions mt-4">
      <%= f.submit "إرسال الإشعار", class: "btn btn-gold" %>
      <%= link_to "إلغاء", admin_notifications_path, class: "btn btn-ghost" %>
    </div>
  <% end %>
</section>
