<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= t("admin.app_name") %></title>
  <%= csrf_meta_tags %>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700&display=swap" rel="stylesheet">
  <style>
    :root {
      --green-900: #0b3326; --green-800: #0f4433; --green-700: #155c45;
      --gold-500: #c9a227; --gold-400: #d9b84a; --cream: #f8f5ec; --ink: #1d2a24;
    }
    * { box-sizing: border-box; }
    body {
      margin: 0; min-height: 100vh; display: grid; place-items: center; padding: 16px;
      font-family: "Cairo", system-ui, sans-serif; color: var(--ink);
      background: radial-gradient(circle at top, var(--green-700), var(--green-900) 70%);
    }
    .card {
      width: 100%; max-width: 400px; background: var(--cream); border-radius: 16px;
      padding: 32px 28px; box-shadow: 0 20px 50px rgba(0,0,0,.35); border-top: 6px solid var(--gold-500);
    }
    .brand { text-align: center; margin-bottom: 24px; }
    .brand img { max-height: 72px; }
    .brand h1 { margin: 8px 0 0; font-size: 1.5rem; color: var(--green-800); }
    .brand p { margin: 4px 0 0; color: #5d6b63; font-size: .9rem; }
    label { display: block; font-weight: 600; margin: 16px 0 6px; }
    input {
      width: 100%; padding: 12px 14px; border: 1px solid #cfd8d2; border-radius: 10px;
      font: inherit; background: #fff;
    }
    input:focus { outline: 2px solid var(--gold-500); border-color: var(--gold-500); }
    input[type="tel"] { direction: ltr; text-align: right; }
    button {
      width: 100%; margin-top: 24px; padding: 12px; border: 0; border-radius: 10px; cursor: pointer;
      font: inherit; font-weight: 700; color: var(--green-900); background: var(--gold-500);
    }
    button:hover { background: var(--gold-400); }
    .flash { padding: 10px 12px; border-radius: 10px; margin-bottom: 8px; font-size: .95rem; }
    .flash.alert { background: #fde8e8; color: #9b1c1c; }
    .flash.notice { background: #e6f4ea; color: var(--green-800); }
  </style>
</head>
<body>
  <main class="card">
    <%= yield %>
  </main>
</body>
</html>
