<!DOCTYPE html>
<html <%= tag.attributes({ lang: "ar", dir: "rtl" }.merge(theme_attribute)) %>>
<head>
  <title><%= [content_for(:title), t("admin.app_name")].compact.join(" · ") %></title>
  <%= render "admin/shared/head" %>
</head>
<body>
  <div class="shell">
    <aside class="sidebar" id="sidebar">
      <div class="sidebar-brand">
        <%= brand_mark(size: 36) %>
        <div>
          <strong>أجهور الكبرى</strong>
          <span>لوحة الإدارة</span>
        </div>
      </div>

      <nav aria-label="القائمة الرئيسية">
        <%= nav_group "عام" do %>
          <%= nav_link "لوحة التحكم", admin_root_path, :home, exact: true %>
        <% end %>
        <%= nav_group "المحتوى" do %>
          <%= nav_link "التصنيفات", admin_categories_path, :categories %>
          <%= nav_link "الأنشطة", admin_firms_path, :firms, count: Firm.pending.count %>
          <%= nav_link "الأخبار والمقالات", admin_articles_path, :articles %>
        <% end %>
        <%= nav_group "الأشخاص" do %>
          <%= nav_link "المستخدمون", admin_users_path, :users %>
        <% end %>
        <%= nav_group "المالية" do %>
          <%= nav_link "الباقات والأسعار", admin_subscription_plans_path, :plans %>
          <%= nav_link "الاشتراكات", admin_subscriptions_path, :subscriptions, count: Subscription.pending.count %>
        <% end %>
      </nav>

      <div class="sidebar-footer">
        <span class="avatar"><%= initials(current_admin.name) %></span>
        <div class="who">
          <strong><%= current_admin.name %></strong>
          <small>صلاحيات كاملة</small>
        </div>
        <%= button_to admin_logout_path, method: :delete, class: "icon-btn", title: "تسجيل الخروج",
              form: { data: { confirm: "تسجيل الخروج؟" } } do %>
          <%= icon(:logout) %>
        <% end %>
      </div>
    </aside>
    <div class="backdrop" data-nav-close></div>

    <div class="main">
      <header class="topbar">
        <button type="button" class="icon-btn md:hidden" data-nav-toggle aria-controls="sidebar" aria-label="القائمة">
          <%= icon(:menu) %>
        </button>
        <div class="page-title">
          <h1><%= content_for(:title) %></h1>
          <% if content_for?(:subtitle) %><p><%= content_for(:subtitle) %></p><% end %>
        </div>
        <%# The design's topbar search is cross-entity; only firm search exists, so it says so. %>
        <%= form_with url: admin_firms_path, method: :get, class: "topbar-search" do |f| %>
          <%= f.search_field :q, placeholder: "ابحث عن نشاط…", "aria-label": "ابحث عن نشاط" %>
        <% end %>
        <%= theme_toggle %>
      </header>

      <main class="content">
        <% flash.each do |type, message| %>
          <div class="flash flash-<%= type %>" role="status">
            <%= icon(type.to_s == "notice" ? :check : :close) %><%= message %>
          </div>
        <% end %>
        <%= yield %>
      </main>
    </div>
  </div>

  <script>
    // Confirm dialogs for forms with data-confirm, and the mobile menu. No JS framework needed.
    document.addEventListener("submit", function (event) {
      var message = event.target.dataset.confirm;
      if (message && !window.confirm(message)) event.preventDefault();
    });
    document.addEventListener("click", function (event) {
      if (event.target.closest("[data-nav-toggle]")) document.body.classList.toggle("nav-open");
      if (event.target.closest("[data-nav-close]")) document.body.classList.remove("nav-open");
    });
  </script>
</body>
</html>
