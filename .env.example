# Copy to .env and adjust
DB_HOST=localhost
DB_USERNAME=postgres
DB_PASSWORD=postgres
# Seeded super admin
SUPER_ADMIN_PHONE=01000000000
SUPER_ADMIN_PASSWORD=change-me-please
CORS_ORIGINS=*
# Where firm owners send subscription payments (shown in GET /api/v1/payment_methods)
INSTAPAY_ADDRESS=yourname@instapay
VODAFONE_CASH_NUMBER=010XXXXXXXX
# docker compose publishes PostgreSQL on 5434 (config/database.yml reads DB_PORT)
DB_PORT=5434
# Object storage for video (Cloudflare R2). Without it, video uploads are refused.
# MEDIA_STORAGE_SERVICE=r2
# R2_ENDPOINT=https://<account id>.r2.cloudflarestorage.com
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# Production (Vercel): see README "Deploy"
# SECRET_KEY_BASE=
# CRON_SECRET=
# ASSUME_SSL=1
# FORCE_SSL=1
