# Copy to .env and adjust
DB_HOST=localhost
DB_USERNAME=postgres
DB_PASSWORD=postgres
# Seeded super admin
SUPER_ADMIN_PHONE=01000000000
SUPER_ADMIN_PASSWORD=change-me-please
CORS_ORIGINS=*
# Run background jobs (Solid Queue) inside `bin/rails s`; without it, run bin/jobs beside the server.
SOLID_QUEUE_IN_PUMA=1
# Where firm owners send subscription payments (shown in GET /api/v1/payment_methods)
INSTAPAY_ADDRESS=yourname@instapay
VODAFONE_CASH_NUMBER=010XXXXXXXX
# Firebase SERVICE-ACCOUNT key for push notifications (not the Android google-services.json):
# Firebase console > Project settings > Service accounts > Generate new private key. Either the
# JSON itself on one line, or a path relative to the app root (no leading slash). Keys under
# config/fcm/ are git-ignored. Not google-services.json: that is the Android app's config and
# cannot send. Locally use the aghour-dev key; production's (aghour-app) lives in the village-env
# secret. Empty = pushes are logged and skipped.
# FCM_SERVICE_ACCOUNT_JSON=config/fcm/dev/service-account.json

# Production (Vercel): see README "Deploy"
# SECRET_KEY_BASE=
# CRON_SECRET=
# ASSUME_SSL=1
# FORCE_SSL=1

# Server for bin/deploy / make deploy (deploy/k8s/README.md)
# DEPLOY_HOST=root@1.2.3.4
