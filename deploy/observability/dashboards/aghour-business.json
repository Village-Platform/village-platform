        },
        {
          "expr": "max(aghour_subscriptions_current)",
          "editorMode": "code",
          "range": true,
          "instant": false,
          "legendFormat": "current",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ]
    },
